projection implementation in class ZBP_C_CS04_CUSTOMER unique;
strict ( 2 );
extensible;
use draft;
use side effects;
define behavior for ZC_CS04_CUSTOMER alias Customer
extensible
use etag
{
  use create;
  use update;
  use delete;

  use action CancelOrder;
  use action ShowStatistic;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _ORDERS { create; with draft; }

}

define behavior for ZC_CS04_ORDERS alias Orders
extensible
use etag
{
  use update;
  use delete;

  use association _CUSTOMER { with draft; }

}