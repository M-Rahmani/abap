managed implementation in class ZBP_R_CS04_ORDERITEMS unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_CS04_ORDERITEMS alias ZrCs04Orderitems
persistent table ZCS04_ORDERITEMS
extensible
draft table ZCS04_ORDRTEMS_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( mandatory : create )
   Customerid,
   Orderid,
   Orderitem;

  field ( readonly )
   LocalCreatedBy,
   LocalCreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

  field ( readonly : update )
   Customerid,
   Orderid,
   Orderitem;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZCS04_ORDERITEMS corresponding extensible
  {
    Customerid = customerid;
    Orderid = orderid;
    Orderitem = orderitem;
    Itemid = itemid;
    Itemdescription = itemdescription;
    Quantity = quantity;
    Unit = unit;
    Price = price;
    ItemTotal = item_total;
    Currency = currency;
    Info = info;
    LocalCreatedBy = local_created_by;
    LocalCreatedAt = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt = last_changed_at;
  }

}