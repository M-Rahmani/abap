managed implementation in class ZBP_R_CS04_STATISTICS unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_CS04_STATISTICS alias ZrCs04Statistics
persistent table ZCS04_STATISTICS
extensible
draft table ZCS04_STTSTICS_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( mandatory : create )
   Interfname,
   Classname;

  field ( readonly )
   LocalCreatedBy,
   LocalCreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

  field ( readonly : update )
   Interfname,
   Classname;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZCS04_STATISTICS corresponding extensible
  {
    Interfname = interfname;
    Classname = classname;
    Activstat = activstat;
    LocalCreatedBy = local_created_by;
    LocalCreatedAt = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt = last_changed_at;
  }

}